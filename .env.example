# Copy to .env.local for local development. Never commit .env.local.
# This site is public marketing only: no secrets, no health data.

# Where CTAs send people (platform app: sign-up, HSA questionnaire).
NEXT_PUBLIC_PLATFORM_URL=http://localhost:8081

# Canonical URL of this marketing site (used for metadata / OG tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Address used by "Talk to our team" links until a contact page exists.
NEXT_PUBLIC_CONTACT_EMAIL=hello@halohealth.example
